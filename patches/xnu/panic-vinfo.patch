diff --git a/pexpert/arm/pe_init.c b/pexpert/arm/pe_init.c
index db1c4a0..d55b2bf 100644
--- a/pexpert/arm/pe_init.c
+++ b/pexpert/arm/pe_init.c
@@ -18,6 +18,7 @@
 #include <arm/caches_internal.h>
 #include <kern/debug.h>
 #include <libkern/section_keywords.h>
+#include <kern/boot_progress.h>
 #include <os/overflow.h>
 
 #include <pexpert/arm64/board_config.h>
@@ -26,6 +27,7 @@
 #include <arm64/sptm/sptm.h>
 #endif
 
+
 /* extern references */
 extern void     pe_identify_machine(boot_args *bootArgs);
 
@@ -557,6 +559,29 @@ PE_create_console(void)
 	} else {
 		PE_initialize_console(&PE_state.video, kPETextMode);
 	}
+#if defined(XNU_BOOT_PROGRESS) && XNU_BOOT_PROGRESS
+	/*
+	 * The kernel can hold a copy of the framebuffer, while ABL keeps scanning
+	 * the boot-args buffer (the one the entry bars paint). Bind the page and
+	 * the panic observer to that buffer so stages are visible.
+	 */
+	{
+		unsigned width = (unsigned int)PE_state.video.v_width;
+		unsigned height = (unsigned int)PE_state.video.v_height;
+		unsigned rowbytes = (unsigned int)PE_state.video.v_rowBytes;
+		uintptr_t base;
+
+		if (rowbytes == 0) {
+			rowbytes = width * 4;
+		}
+		base = (uintptr_t)ml_io_map_wcomb(
+		    (vm_offset_t)((boot_args *)PE_state.bootArgs)->Video.v_baseAddr,
+		    (vm_size_t)rowbytes * height);
+		if (base != 0) {
+			boot_progress_bind(base, width, height, rowbytes, 32);
+		}
+	}
+#endif
 }
 
