+/*
+ * UniXNU ArmCpu's platform sleep hook. ArmCpu declares it as a weak import and
+ * installs armcpuPlatformSleep when its GIC sleep/resume path is enabled. The
+ * cupid bring-up runs with sleep-disabled=1, so a NULL default is sufficient
+ * and keeps the component linkable when no SoC platform provides it.
+ */
+void (*arm64_platform_sleep_hook)(boolean_t boot_cpu) = NULL;
