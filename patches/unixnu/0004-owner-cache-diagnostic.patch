--- a/patches/xnu-12377/offline-owner-systemos-mount.patch
+++ b/patches/xnu-12377/offline-owner-systemos-mount.patch
@@ -87,7 +87,8 @@
 +	request.flags |= MNT_UNION;
 +#endif
 +	if (device_vnode) vnode_put(device_vnode);
