+// The v4 boot path on some boards puts the stock vendor ramdisk in front of
+// the boot ramdisk, so the FAT superblock is not at offset 0. Scan for it and
+// log a word every 16 MiB so a photo shows what the initrd actually contains.
+#define FAT_SCAN_LIMIT (256ULL * 1024 * 1024)
+
+STATIC
+UINT64
+FindFatBootSector (
+  IN CONST UINT8  *Base,
+  IN UINT64        Size
+  )
+{
+  UINT64  Offset;
+
+  for (Offset = 0;
+       ((Offset + RAM_BLOCK_SIZE) <= Size) && (Offset < FAT_SCAN_LIMIT);
+       Offset += RAM_BLOCK_SIZE)
+  {
+    CONST UINT8  *Sector = Base + Offset;
+    if ((Offset % (16ULL * 1024 * 1024)) == 0) {
+      DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: +0x%lx: %08x %08x\n",
+              Offset, ((CONST UINT32 *)Sector)[0], ((CONST UINT32 *)Sector)[1]));
+    }
+    if ((Sector[510] == 0x55) && (Sector[511] == 0xAA) &&
+        ((CompareMem ((VOID *)(Sector + 54), "FAT", 3) == 0) ||
+         (CompareMem ((VOID *)(Sector + 82), "FAT", 3) == 0)))
+    {
+      return Offset;
+    }
+  }
+  return MAX_UINT64;
+}
+
+// The prefix ABL prepends is not guaranteed to end on a sector boundary, so
+// the 512-byte walk can miss the FAT. Search for the payload volume label
+// ("CUPIDESP" in board.toml) and derive the boot sector from offset 71.
+#define FAT_LABEL_SCAN_LIMIT (128ULL * 1024 * 1024)
+
+STATIC
+UINT64
+FindFatByLabel (
+  IN CONST UINT8  *Base,
+  IN UINT64        Size
+  )
+{
+  STATIC CONST CHAR8  Label[] = { 'C', 'U', 'P', 'I', 'D', 'E', 'S', 'P' };
+  UINT64              Limit = (Size < FAT_LABEL_SCAN_LIMIT) ? Size : FAT_LABEL_SCAN_LIMIT;
+  UINT64              Index;
+
+  for (Index = 0; (Index + sizeof (Label)) <= Limit; ++Index) {
+    if (Base[Index] != 'C') {
+      continue;
+    }
+    if (CompareMem ((VOID *)(Base + Index), (VOID *)Label, sizeof (Label)) != 0) {
+      continue;
+    }
+    if (Index < 71) {
+      continue;
+    }
+    {
+      UINT64  Boot = Index - 71;
+      if (((Boot + RAM_BLOCK_SIZE) <= Size) &&
+          (Base[Boot + 510] == 0x55) && (Base[Boot + 511] == 0xAA) &&
+          (CompareMem ((VOID *)(Base + Boot + 82), "FAT32", 5) == 0))
+      {
+        return Boot;
+      }
+    }
+  }
+  return MAX_UINT64;
+}
