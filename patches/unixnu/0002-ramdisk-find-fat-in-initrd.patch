+++ b/package/UniXNUPkg/Driver/UniXNURamDiskDxe/UniXNURamDiskDxe.c
@@ -128,6 +128,39 @@ STATIC EFI_BLOCK_IO_PROTOCOL  mBlockIo = {
   RamBlockFlush
 };
 
+// The v4 boot path on some boards puts the stock vendor ramdisk in front of
+// the boot ramdisk, so the FAT superblock is not at offset 0. Scan for it and
+// log a word every 16 MiB so a photo shows what the initrd actually contains.
+#define FAT_SCAN_LIMIT (256ULL * 1024 * 1024)
+
+STATIC
+UINT64
+FindFatBootSector (
+  IN CONST UINT8  *Base,
+  IN UINT64        Size
+  )
+{
+  UINT64  Offset;
+
+  for (Offset = 0;
+       ((Offset + RAM_BLOCK_SIZE) <= Size) && (Offset < FAT_SCAN_LIMIT);
+       Offset += RAM_BLOCK_SIZE)
+  {
+    CONST UINT8  *Sector = Base + Offset;
+    if ((Offset % (16ULL * 1024 * 1024)) == 0) {
+      DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: +0x%lx: %08x %08x\n",
+              Offset, ((CONST UINT32 *)Sector)[0], ((CONST UINT32 *)Sector)[1]));
+    }
+    if ((Sector[510] == 0x55) && (Sector[511] == 0xAA) &&
+        ((CompareMem ((VOID *)(Sector + 54), "FAT", 3) == 0) ||
+         (CompareMem ((VOID *)(Sector + 82), "FAT", 3) == 0)))
+    {
+      return Offset;
+    }
+  }
+  return MAX_UINT64;
+}
+
 STATIC
 VOID
 PublishInitrd (
@@ -166,6 +199,19 @@ PublishInitrd (
     return;
   }
 
+  {
+    CONST UINT8  *Base = (CONST UINT8 *)(UINTN)Start;
+    UINT64        FatOffset = FindFatBootSector (Base, End - Start);
+
+    if (FatOffset == MAX_UINT64) {
+      DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: no FAT boot sector in 0x%lx bytes; first words %08x %08x\n",
+              End - Start, ((CONST UINT32 *)Base)[0], ((CONST UINT32 *)Base)[1]));
+    } else if (FatOffset != 0) {
+      DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: FAT boot sector at +0x%lx, initrd 0x%lx\n", FatOffset, Start));
+      Start += FatOffset;
+    }
+  }
+
